{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brawl Stars Hub",
  "version": "0.2.3",
  "identifier": "com.brawlstarshub.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Brawl Stars Hub",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 620,
        "decorations": false,
        "center": true,
        "visible": false
